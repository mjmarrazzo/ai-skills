  "schemas": {
    "WidgetCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[A-Za-z0-9 ]+$",
          "description": "Display name shown in the widget catalog."
        },
        "code": {
          "type": "string",
          "pattern": "[A-Z]{3}",
          "example": "ABC"
        },
        "sku": {
          "type": "string",
          "pattern": "^\\p{IsLatin}+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "SMALL",
            "LARGE"
          ]
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "multipleOf": 0.01
        },
        "quantity": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 500
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "birthday": {
          "type": "string",
          "format": "date"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "contactEmail": {
          "type": "string",
          "format": "email"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "callbackUrl": {
          "type": "string",
          "format": "url"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer"
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 20
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PartRef"
          }
        },
        "id": {
          "type": "string",
          "readOnly": true
        },
        "note": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "PartRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "Widget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "SMALL",
            "LARGE"
          ]
        }
      }
    },
    "PartCreate": {
      "type": "object",
      "required": [
        "widgetId",
        "label"
      ],
      "properties": {
        "widgetId": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string",
          "maxLength": 10
        }
      }
    },
    "Part": {
      "type": "object",
      "properties": {
        "partId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "Shape": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Circle"
        },
        {
          "$ref": "#/components/schemas/Square"
        }
      ]
    },
    "Circle": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number"
        }
      }
    },
    "Square": {
      "type": "object",
      "properties": {
        "side": {
          "type": "number"
        }
      }
    }
  },
  "security_schemes": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer"
    }
  },
